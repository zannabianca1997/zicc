+++
name="Quicksort"
+++

; 100 is the call stack size. The call frame is about 3, so it should amount to a
; recursion depth of 30. Quicksort should then handle any lenght.
DATA input_start: $end+100  input_end: $end+100

main:
    CALL #read_list

    ; calling the sort function
    PUSH input_start    ; first parameter
    PUSH input_end      ; second parameter
    CALL #qsort
    INB  #-2            ; pop parameters

    CALL #print_list

    RET

qsort:
    ; if start + 1 >= end, return (0 or 1 element)
    ADD @-3 #1 @0     ; @0 = start + 1
    SLT @0 @-2 @1     ; @1 = (start + 1 < end) ? 1 : 0
    JEZ @1 #return@qsort

    ; choose pivot = *(end - 1)
    MOV @-2 @0        ; @0 = end
    ADD @0 #-1 @0     ; @0 = end - 1
    LOAD @0 @0        ; @0 = pivot = *(end - 1)

    ; i = start - 1
    MOV @-3 @1        ; @1 = start
    ADD @1 #-1 @1     ; @1 = i = start - 1

    ; j = start
    MOV @-3 @2        ; @2 = j = start

    ; end_minus_1 = end - 1
    MOV @-2 @3        ; @3 = end
    ADD @3 #-1 @3     ; @3 = end - 1

    loop@qsort:
        ; if j >= end - 1, exit loop
        SLT @2 @3 @4    ; @4 = (j < end - 1) ? 1 : 0
        JEZ @4 #end_loop@qsort

        ; if *j > pivot, skip swap
        LOAD @2 @4      ; @4 = *j
        SLT @0 @4 @5    ; @5 = (pivot < *j) ? 1 : 0, i.e., *j > pivot
        JNZ @5 #skip@qsort

        ; i++
        ADD @1 #1 @1    ; i = i + 1

        ; swap *i and *j
        LOAD @1 @5      ; @5 = *i
        LOAD @2 @6      ; @6 = *j
        STORE @5 @2     ; *j = *i
        STORE @6 @1     ; *i = *j

        skip@qsort:
        ADD @2 #1 @2    ; j++
        JMP #loop@qsort

    end_loop@qsort:
    ; pivot_pos = i + 1
    ADD @1 #1 @1        ; @1 = pivot_pos

    ; swap *(pivot_pos) and *(end - 1)
    LOAD @1 @4          ; @4 = *pivot_pos
    LOAD @3 @5          ; @5 = *(end - 1)
    STORE @4 @3         ; *(end - 1) = *pivot_pos
    STORE @5 @1         ; *pivot_pos = pivot (was at *(end - 1))

    ; recurse left: qsort(start, pivot_pos)
    PUSH @-3            ; push start
    PUSH @1             ; push pivot_pos
    CALL #qsort
    INB #-2             ; pop params

    ; recurse right: qsort(pivot_pos + 1, end)
    ADD @1 #1 @0        ; @0 = pivot_pos + 1
    PUSH @0             ; push pivot_pos + 1
    PUSH @-2            ; push end
    CALL #qsort
    INB #-2             ; pop params

    return@qsort:
    RET

read_list:
    read:   INP @0              ; Read a value
    JEZ @0  #read_list_end     ; If zero has been written, exit

    STORE   @0  input_end       ; Store the input value
    INC input_end               ; Increase the input end pointer

    JMP #read                   ; Read next char

    read_list_end: RET         ; Return

print_list:
    MOV input_start @0    ; @0 = cur = *input_start
    MOV input_end @1      ; @1 = end = *input_end

    loop@print_list:
        SEQ @0 @1 @2        ; @2 = (cur == end)
        JNZ @2 #done@print_list

        LOAD @0 @2          ; @2 = *cur
        OUT @2
        ADD @0 #1 @0        ; cur++
        JMP #loop@print_list

    done@print_list:
    RET
